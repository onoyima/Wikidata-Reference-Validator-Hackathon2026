# Copy this file to .env and fill in the values you need.
# .env is git-ignored; never commit real secrets.

# Signs the session cookie. Required for stable logins across restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Wikimedia OAuth 2.0 consumer.
# The client ID is public and already defaulted in app.py; override to use
# a different consumer.
WIKIMEDIA_CLIENT_ID=a7d62252493d736604d7219ca46e4f05

# Optional. Leave empty to use PKCE as a public client. Set it only if your
# consumer was registered as confidential.
WIKIMEDIA_CLIENT_SECRET=

# Only for consumers registered WITHOUT a secret (public clients). Wikimedia
# consumers that have a secret must send it, so leave this false for those.
WIKIMEDIA_USE_PKCE=false

# Must exactly match the callback URL registered for the consumer.
# Defaults to <host>/login/callback when empty.
WIKIMEDIA_REDIRECT_URI=http://127.0.0.1:5000/login/callback

# Set to true when serving over HTTPS so the session cookie is Secure.
SESSION_COOKIE_SECURE=false
